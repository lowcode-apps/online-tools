{
  "name": "online-tools",
  "version": "2.0.0",
  "description": "Free online tools for hashing, encoding, compression, and cryptography",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "generate:html": "node scripts/generate-html.js",
    "remove:tracking": "node scripts/remove-tracking.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "online-tools",
    "hash",
    "encoding",
    "compression",
    "cryptography",
    "privacy"
  ],
  "author": "lowcode-apps",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.12",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.19.0",
    "@playwright/test": "^1.41.1",
    "vitest": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "cheerio": "^1.0.0-rc.12",
    "glob": "^10.3.10",
    "happy-dom": "^13.3.5"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "crypto-js": "^4.2.0"
  }
}
